{
    "name": "charged-labs/tailwindphp",
    "description": "Pure-PHP port of the Tailwind CSS v4 compiler. Compile Tailwind utility classes at runtime with no Node.js toolchain. Powers the Charged UI component ecosystem for WordPress and Drupal.",
    "type": "library",
    "keywords": [
        "tailwind",
        "tailwindcss",
        "css",
        "compiler",
        "utility-classes"
    ],
    "homepage": "https://github.com/charged-labs/tailwindphp",
    "license": "MIT",
    "authors": [
        {
            "name": "Dennis Josek",
            "role": "Original author of tailwindphp/tailwindphp"
        },
        {
            "name": "Charged",
            "homepage": "https://charged.dev",
            "role": "Maintainer of this fork"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "TailwindPHP\\Exception\\": "src/Exception/",
            "TailwindPHP\\Plugin\\": "src/Plugin/",
            "TailwindPHP\\Minifier\\": "src/Minifier/",
            "TailwindPHP\\Normalizer\\": "src/Normalizer/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ChargedLabs\\TailwindPHP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
